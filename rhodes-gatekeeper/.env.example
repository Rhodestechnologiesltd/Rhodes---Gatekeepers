# =====================================================================
# Rhodes Gatekeeper — environment configuration
# Copy to .env for local development. PLACEHOLDERS ONLY — never commit real values.
# In production, inject these from a secrets manager (Azure Key Vault, AWS Secrets Manager,
# Docker/Kubernetes secrets, etc.), not from a file in the repository.
# =====================================================================

# --- Runtime -----------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=8080
APP_BASE_URL=https://gatekeeper.example.com
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
JOBS_ENABLED=true               # outbox delivery + retention jobs (enable on exactly one instance)

# --- Database ----------------------------------------------------------
# Production requires PostgreSQL. SQLite is for local development only.
DB_CLIENT=sqlite                # pg | sqlite
DATABASE_URL=postgres://gatekeeper:CHANGE_ME@db-host:5432/gatekeeper
DB_SSL=false                    # true to require TLS to PostgreSQL
SQLITE_FILENAME=./data/gatekeeper.sqlite

# --- Sessions / HTTP ---------------------------------------------------
SESSION_TTL_HOURS=12            # sliding inactivity timeout
COOKIE_SECURE=auto              # auto = secure cookies when NODE_ENV=production
TRUST_PROXY=loopback            # set to your reverse proxy's address/CIDR, or "false"

# --- Data protection ---------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Used to HMAC ID numbers (repeat-visitor matching) and to encrypt full ID numbers if enabled.
# Losing or rotating this key breaks repeat-visitor matching and decryption of stored IDs.
DATA_ENCRYPTION_KEY=
# Second gate for storing full ID numbers. Leave false unless the company has formally approved it.
# Full numbers are stored only if this is true AND an administrator enables it in Settings.
ALLOW_FULL_ID_STORAGE=false

# --- Email: Microsoft 365 via Microsoft Graph ---------------------------
# graph    = send through Microsoft 365 (production)
# devlog   = NON-PRODUCTION logger; nothing is sent (refused when NODE_ENV=production)
# disabled = record notifications as skipped
EMAIL_PROVIDER=devlog
ALLOW_DEV_EMAIL_IN_PRODUCTION=false
M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_SECRET=PLACEHOLDER_CLIENT_SECRET
M365_SENDER_ADDRESS=gatekeeper@example.com

# --- Visit folders: encrypted file storage ------------------------------
# ID card photos, number-plate photos and PO/invoice documents, AES-256-GCM encrypted at rest.
# Back this folder up together with the database (and keep DATA_ENCRYPTION_KEY safe — files cannot be
# read without it).
STORAGE_DIR=./data/files

# --- SharePoint / OneDrive copy of each visit folder (optional) ------------
# Uses the same Microsoft 365 app registration (M365_TENANT_ID / CLIENT_ID / CLIENT_SECRET above).
# Needs the Graph application permission Sites.Selected + a write grant on the target site (see README).
SHAREPOINT_ENABLED=false
SHAREPOINT_DRIVE_ID=b!PLACEHOLDER_DOCUMENT_LIBRARY_DRIVE_ID
SHAREPOINT_BASE_PATH=Rhodes Gatekeeper

# --- Gate tablet app ---------------------------------------------------------
# The installed Android/iOS app calls the API from capacitor://localhost / https://localhost (allowed by
# default). Only for testing the tablet app in a desktop browser, list its dev origin here:
MOBILE_DEV_ORIGINS=http://localhost:5174

# --- Identity verification -----------------------------------------------
# No external UAE identity-verification service is integrated. Scanned IDs are labelled "scanned".
ID_VERIFICATION_PROVIDER=none
